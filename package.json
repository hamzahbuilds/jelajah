{
  "name": "jelajah",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "fixtures": "node scripts/extract-text.mjs",
    "seed:gen": "node scripts/seed.mjs",
    "db:local": "wrangler d1 execute jelajah-db --local --file=./migrations/0001_init.sql && wrangler d1 execute jelajah-db --local --file=./scripts/seed.sql",
    "db:remote": "wrangler d1 execute jelajah-db --remote --file=./migrations/0001_init.sql && wrangler d1 execute jelajah-db --remote --file=./scripts/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "dev:full": "npm run build && wrangler dev"
  },
  "dependencies": {
    "hono": "^4",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^5",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
